{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#111827" },
        { "slug": "muted", "name": "Muted", "color": "#64748b" },
        { "slug": "line", "name": "Line", "color": "#e5e7eb" },
        { "slug": "soft", "name": "Soft", "color": "#f8fafc" },
        { "slug": "soft-blue", "name": "Soft Blue", "color": "#eaf8ff" },
        { "slug": "blue", "name": "Blue", "color": "#0b77d9" },
        { "slug": "accent", "name": "Accent", "color": "#23d5ff" },
        { "slug": "navy", "name": "Navy", "color": "#06111f" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "13px", "name": "Small" },
        { "slug": "normal", "size": "16px", "name": "Normal" },
        { "slug": "medium", "size": "18px", "name": "Medium" },
        { "slug": "large", "size": "28px", "name": "Large" },
        { "slug": "x-large", "size": "40px", "name": "Extra Large" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw", "vh" ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#111827"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "16px",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#0b77d9"
        }
      },
      "button": {
        "border": {
          "radius": "8px"
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontWeight": "800"
        }
      }
    }
  },
  "templateParts": [
    { "name": "mobile-header", "title": "Mobile Header", "area": "header" },
    { "name": "sidebar", "title": "Sidebar", "area": "uncategorized" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-products", "title": "Products Page", "postTypes": [ "page" ] },
    { "name": "single-product", "title": "Single Product", "postTypes": [ "product" ] }
  ]
}
